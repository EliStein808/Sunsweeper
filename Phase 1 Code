


//Servo Setup: 
      #include <Servo.h>
      Servo Yaw;  // Creating Yaw servo, bottom
      Servo Roll; // Creating Roll servo, top

      int servoPinYaw = 9; //pinout from Arduino
      int servoPinRoll = 8; //pinout from Arduino

      const int LDR1 = A1; // LDR pin setup
      const int LDR2 = A2;
      const int LDR3 = A3; 
      const int LDR4 = A4;
      
      
      void setup() {
              Yaw.attach(servoPinYaw);  // Attach the servo on pin 9
              Roll.attach(servoPinRoll);  // Attach the servo on pin 8
              Serial.begin(9600);    // Initialize serial communication at 9600 baud
      }

      
      void loop() {
              int lightValue1 = analogRead(LDR1); // Read the input voltage (0-1023)
              Serial.print("LDR1 Light Value: ");
              Serial.println(lightValue1);          // Print the reading to the monitor
              delay(500);   // Short delay for readability 

              Yaw.write(0); //move to 0 deg
              Roll.write(0); //move to 90deg
            
              int lightValue2 = analogRead(LDR2); // Read the input voltage (0-1023)
              Serial.print("LDR2 Light Value: ");
              Serial.println(lightValue2);          // Print the reading to the monitor
              delay(500);                          // Short delay for readability
              
              Yaw.write(90); //move to 90deg
              Roll.write(90); //move to 90deg
              
              int lightValue3 = analogRead(LDR3); // Read the input voltage (0-1023)
              Serial.print("LDR3 Light Value: ");
              Serial.println(lightValue3);          // Print the reading to the monitor
              delay(500); 
            
              Yaw.write(180); //move to 180deg
              Roll.write(180); //move to 180deg

              int lightValue4 = analogRead(LDR4); // Read the input voltage (0-1023)
              Serial.print("LDR4 Light Value: ");
              Serial.println(lightValue4);          // Print the reading to the monitor
              delay(500);
      }
  




