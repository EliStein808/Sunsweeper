


//Servo Setup: 
     #include <Servo.h>
      Servo Yaw;  // Creating Yaw servo, bottom
      Servo Roll; // Creating Roll servo, top

      int servoPinYaw = 9; //pinout from Arduino
      int servoPinRoll = 8; //pinout from Arduino

      const int LDR1 = A1; // LDR pin setup
      const int LDR2 = A2;
      const int LDR3 = A3; 
      const int LDR4 = A4;
      
      
      void setup() {
              Yaw.attach(servoPinYaw);  // Attach the servo on pin 9
              Roll.attach(servoPinRoll);  // Attach the servo on pin 8
              Serial.begin(9600);    // Initialize serial communication at 9600 baud
      }

      
      void loop() {
              int light1 = analogRead(LDR1); // Read the input voltage (0-1023)
              int light2 = analogRead(LDR2);
              int light3 = analogRead(LDR3);
              int light4 = analogRead(LDR4);

              int maxlight = light1;
              String maxlightString = "light 1";
              
                if (light2 > maxlight) {
                  maxlight = light2;
                  maxlightString = "light 2";
                  }
                  
                if (light3 > maxlight) {
                  maxlight = light3;
                  maxlightString = "light 3";
                  }
                  
                if (light4 > maxlight) {
                  maxlight = light4;
                  maxlightString = "light 4";}

              Serial.print("Max Light: ");
              Serial.println(maxlightString);          // Print the reading to the monitor

              Serial.print("Value: ");
              Serial.println(maxlight);
              
              delay(500);                          // Short delay for readability
              
      }
  
